<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Tankard</AssemblyName>
    <RootNamespace>RavenIron.Tankard</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- Vendor\ServerSync.cs is blaxxun's file with nullable annotations; it compiles clean with these two warnings
         turned down, as in Ragnarok's Wrath and Valkyrie's Cargo. Our own files carry no nullable syntax. -->
    <NoWarn>$(NoWarn);CS8632;CS0618</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Raven Iron</Company>
    <Product>Tankard</Product>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <SourceRoot Include="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>

  <!-- Shared libs folder at the repo root, populated by tools\fetch-libs.ps1 (gitignored). -->
  <PropertyGroup>
    <LibsDir>$(MSBuildThisFileDirectory)..\libs</LibsDir>
  </PropertyGroup>

  <Target Name="CheckLibs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(LibsDir)\assembly_valheim_publicized.dll')"
           Text="libs\ is missing or empty. Run tools\fetch-libs.ps1 to populate it from your Valheim install." />
  </Target>

  <!-- Item icons, drawn by tools\icons\make-icons.js; Registration\Icons.cs loads them by this name. -->
  <ItemGroup>
    <EmbeddedResource Include="Icons\*.png" LogicalName="icon_%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(LibsDir)\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(LibsDir)\assembly_utils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(LibsDir)\assembly_guiutils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(LibsDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LibsDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(LibsDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(LibsDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- For the vendored ServerSync only: its connect-error patch writes FejdStartup's TMP text. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(LibsDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(LibsDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(LibsDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(LibsDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
